# Irreplaceable but too large for git: teleop episodes, trained policies, eval runs.
# Their HASHES are committed (b601/registry/), the bytes are backed up off-machine.
datasets/
checkpoints/
artifacts/
.venv/
.venv-dev/
__pycache__/
*.pyc
.pytest_cache/
.worktrees/
.superpowers/

# Vendor kinematic model. Same rule as above: the bytes stay out, the HASH is
# committed (URDF_SHA256 in b601/setup/pins.env). This path is a machine-local
# symlink into the vendor checkout — committing it would point every other
# machine, including the A6000 fallback, at a directory that does not exist.
b601/setup/urdf/

